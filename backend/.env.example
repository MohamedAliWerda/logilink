PORT=3001
SUPABASE_URL=https://your-project.supabase.co
# Backend uses service-role for server-to-server queries.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
# Fallback used only if SUPABASE_SERVICE_ROLE_KEY is unset.
SUPABASE_KEY=replace_with_publishable_anon_key
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# MUST be at least 32 characters and MUST NOT equal 'replace_with_a_strong_secret'.
JWT_SECRET=replace_with_a_strong_secret

# Comma-separated list of allowed browser origins. Server rejects other Origins.
CORS_ORIGINS=http://localhost:4200

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_API_KEY_PRIMARY=
GEMINI_MODEL_PRIMARY=
GEMINI_API_KEY_SECONDARY=
GEMINI_MODEL_SECONDARY=

# HuggingFace
HF_MODEL=
HF_API_TOKEN=
HF_ACCOUNT_NAME=

# MongoDB
MONGO_URI=
MONGO_DB_NAME=

# Python sidecars
RECOMMENDATION_PYTHON_SERVICE_URL=http://127.0.0.1:8002
RECOMMENDATION_PYTHON_TIMEOUT_MS=999999999
SCORE_V2_TIMEOUT_MS=999999999
EMPLOYABILITY_PYTHON_EXECUTABLE=python

# SMTP (Gmail app password recommended)
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=LogiLink
FEEDBACK_FORM_URL=
